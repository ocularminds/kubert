{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Blazra chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workload",
    "blazra",
    "serviceAccount",
    "rbac",
    "service",
    "imagePullSecrets",
    "podAnnotations",
    "podLabels",
    "nodeSelector",
    "tolerations",
    "affinity",
    "terminationGracePeriodSeconds"
  ],
  "properties": {
    "nameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicaCount",
        "containerName",
        "image",
        "command",
        "args",
        "ports",
        "env",
        "resources",
        "securityContext"
      ],
      "properties": {
        "replicaCount": {
          "type": "integer",
          "const": 1,
          "description": "One replica prevents duplicate registry polling from sidecars."
        },
        "containerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
        },
        "image": {
          "$ref": "#/definitions/taggedImage"
        },
        "command": {
          "$ref": "#/definitions/stringArray"
        },
        "args": {
          "$ref": "#/definitions/stringArray"
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "resources": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        }
      }
    },
    "blazra": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "pollInterval",
        "updatePolicy",
        "connectTimeout",
        "requestTimeout",
        "dryRun",
        "registryCredentials",
        "resources",
        "securityContext"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/sidecarImage"
        },
        "pollInterval": {
          "type": "string",
          "pattern": "^PT(?:(?:1[0-9]|[2-5][0-9])S|(?:[1-9]|[1-5][0-9])M(?:[0-5]?[0-9]S)?|(?:[1-9]|1[0-9]|2[0-3])H(?:[0-5]?[0-9]M)?(?:[0-5]?[0-9]S)?|24H)$"
        },
        "updatePolicy": {
          "enum": ["PATCH", "MINOR", "MAJOR"]
        },
        "connectTimeout": {
          "type": "string",
          "pattern": "^PT(?:[1-9][0-9]*H(?:[0-9]+M)?(?:[0-9]+S)?|[1-9][0-9]*M(?:[0-9]+S)?|[1-9][0-9]*S)$"
        },
        "requestTimeout": {
          "type": "string",
          "pattern": "^PT(?:[1-9][0-9]*H(?:[0-9]+M)?(?:[0-9]+S)?|[1-9][0-9]*M(?:[0-9]+S)?|[1-9][0-9]*S)$"
        },
        "dryRun": {
          "type": "boolean"
        },
        "registryCredentials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "usernameKey", "tokenKey"],
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "usernameKey": {
              "$ref": "#/definitions/nonEmptyString"
            },
            "tokenKey": {
              "$ref": "#/definitions/nonEmptyString"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "maxLength": 63
        },
        "annotations": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "create": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "name": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create"],
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "type", "port", "targetPort"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "targetPort": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "$ref": "#/definitions/nonEmptyString"
          }
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    }
  },
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pullPolicy": {
      "enum": ["Always", "IfNotPresent", "Never"]
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$"
    },
    "taggedImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "$ref": "#/definitions/repository"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "$ref": "#/definitions/pullPolicy"
        }
      },
      "oneOf": [
        {
          "properties": {
            "tag": {
              "minLength": 1
            },
            "digest": {
              "maxLength": 0
            }
          }
        },
        {
          "properties": {
            "digest": {
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "sidecarImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "$ref": "#/definitions/repository"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "$ref": "#/definitions/pullPolicy"
        }
      }
    }
  }
}
